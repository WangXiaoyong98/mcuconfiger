{%- extends "csp-file-base.main.c.j2" %}

{%- macro init_func(name, modules) %}
    {%- if name in modules %}
    csp_{{ name|lower() }}_init();
    {%- endif %}
{%- endmacro %}

{%- set modules = CSP.project.modules|sort %}

{%- block includes %}
#include <stdio.h>
#include "driverlib.h"
#include "device.h"
#include "csp_board.h"
#include "debug_console.h"
#include "stp_hal.h"
#include "core_cm4.h"
{%- for module in modules %}
{%- endfor %}
{%- endblock includes %}
#define DEMO_SCI          SCI1
#define BOARD_DEBUG_UART_INSTANCE 0U
#define DEMO_BAUD  115200

/*!
 * @brief Main function
 */
int main(void)
{
    uint16_t wwdt_reset_count = 0;
    wwdt_test_config_t test_config;
    wwdt_config_t config;

   //
    // Initialize device clock and peripherals
    //
    Device_init();
	
	HAL_Init();

    Board_init();  
    
#if DBGCONSOLE_TYPE == DEBUGCONSOLE_REDIRECT_TO_TOOLCHAIN
    UartStdOutInit(DEMO_SCI_CLK_FREQ, DEMO_BAUD);
    
#else
    DbgConsole_Init(BOARD_DEBUG_UART_INSTANCE, DEMO_BAUD, kSerialPort_Uart, DEVICE_OSCSRC_FREQ);
#endif

		PRINTF("hello world ---\r\n");
		

		return 0;
}


