static void WaitWctClose(WWDT_Type *base)
{
    /* Accessing register by bus clock */
    for (uint32_t i = 0; i < WWDT_WCT_INSTRUCITON_COUNT; i++)
    {
        (void)base->RSTCNT;
    }
}

/*!
 * @brief Gets the Watchdog timer output.
 *
 * @param base WWDT peripheral base address
 * @return Current value of watchdog timer counter.
 */
static inline uint32_t GetTimerOutputValue(WWDT_Type *base)
{
    return (uint32_t)((((uint32_t)base->TMROUTH) << 16U) | (base->TMROUTL));
}

void mydelay_us(uint32_t x)
{
    while(x>0)
    {
        x--;
    }
}

