#include "csp_board.h"

//*****************************************************************************
//
// Board Configurations
// Initializes the rest of the modules. 
// Call this function in your application if you wish to do all module 
// initialization.
// If you wish to not use some of the initializations, instead of the 
// Board_init use the individual Module_inits
//
//*****************************************************************************
void Board_init()
{
	PinMux_init();
}

//*****************************************************************************
//
// PINMUX Configurations
//
//*****************************************************************************
void PinMux_init()
{
{%- for channel in CSP.project|pin_channels() %}
{%- set function = CSP.project|pin_function(channel) %}
{%- if function %}
{%- set key = function.split(":")[0] %}
{%- set gpio_num = "0" %}

{%- if function.startswith("GPIO:") %}
{%- set gpio_num = function.split(":")[1] %}
	GPIO_setPinConfig(GPIO_{{ gpio_num }}_GPIO{{ gpio_num }});
{%- else %}
	{%- set gpio_info = function %}  {#- 使用第一次获取的function值，避免重复调用 -#}
	{%- if gpio_info.startswith("GPIO:") %}
		{%- set gpio_num = gpio_info.split(":")[1] %}
	{%- else %}
		{%- set chip_gpio_num = CSP.project|get_gpio_number_from_chip_db(key)|default("0") %}
		{%- set gpio_num = chip_gpio_num %}  {#- 直接使用芯片数据库的值，无论是否为"0" -#}
	{%- endif %}
	GPIO_setPinConfig(GPIO_{{ gpio_num }}_{{ key }});
{%- endif %}
{%- endif %}
{%- endfor %}
 
}


