{%- extends "csp-file-base.c.j2" %}

{%- set pins = CSP.project|sp28038_pin_configurations %}

{%- block includes %}
#include "csp_gpio.h"
#include "pin_map.h"
{%- endblock %}

{%- block function_body %}
void csp_gpio_init(void)
{
{%- for pin in pins %}
    /* GPIO{{ pin.pin }} */
    GPIO_setPinConfig({{ pin.macro }});
{%- if pin.direction %}
    GPIO_setDirectionMode({{ pin.pin }}U, {{ pin.direction }});
{%- endif %}
    GPIO_setPadConfig({{ pin.pin }}U, {{ pin.pad }});
    GPIO_setQualificationMode({{ pin.pin }}U, {{ pin.qualification }});
{%- endfor %}
}
{%- endblock %}
